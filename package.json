{
  "name": "mc-browser-stream",
  "version": "1.0.0",
  "private": true,
  "description": "Playable Minecraft stream in the browser (mineflayer + prismarine-viewer)",
  "main": "src/server/index.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start": "node src/server/index.js",
    "dev": "npm run build:dev && node src/server/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "minecraft-assets": "^1.12.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "qrcode": "1.5.4",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "three": "0.128.0",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
