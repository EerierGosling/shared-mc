# Visitors type the server they want on the join screen. MC_HOST is optional:
# when set it is the placeholder there, and what a blank field connects to.
# MC_HOST=localhost
MC_PORT=25565
# Placeholder shown instead of MC_HOST when that is not reachable by visitors
# (for example the compose service name).
# MC_PUBLIC_HOST=play.example.com
MC_VERSION=1.20.4
MC_USERNAME=StreamBot
# offline | microsoft
MC_AUTH=offline

# Web server
PORT=3000

# Chunk radius streamed to each browser
VIEW_DISTANCE=6
# Block reach for dig/place/interact. Capped at 4.5 in config.js; past that the
# crosshair targets blocks mineflayer will not dig.
REACH=4.5

# Push-to-talk chat on touch devices, transcribed by Deepgram. Leave unset to
# hide the talk button.
# DEEPGRAM_API_KEY=
