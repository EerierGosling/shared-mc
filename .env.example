# Minecraft server the bot logs into
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.20.4
MC_USERNAME=StreamBot
# offline | microsoft
MC_AUTH=offline

# Web server
PORT=3000

# Chunk radius streamed to each browser
VIEW_DISTANCE=6
# Block reach for dig/place/interact. Capped at 4.5 in config.js; past that the
# crosshair targets blocks mineflayer will not dig.
REACH=4.5
